# Ignore large unnecessary folders
__pycache__/
*.pyc
.DS_Store

# Ignore notebooks and data files
*.ipynb
*.csv
*.pkl
*.h5
*.zip
*.tar
*.gz

# Ignore media files
*.mp4
*.avi
*.mov
*.mkv
*.mp3
*.wav
*.jpg
*.jpeg
*.png
*.gif
*.webp

# Ignore whole folders that aren’t needed at runtime
dataset/
videos/
images/
screenshots/
script/
python code/
